{
  "manifest_version": 3,
  "name": "Prompt Multiple AIs",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "prompt-multiple-ais@extension",
      "strict_min_version": "121.0"
    }
  },
  "action": {},
  "permissions": ["tabs", "contextMenus", "storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-scripts/common.js", "content-scripts/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content-scripts/common.js", "content-scripts/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://deep-seek.ai/*"],
      "js": ["content-scripts/common.js", "content-scripts/deepseek.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.qwen.ai/*"],
      "js": ["content-scripts/common.js", "content-scripts/qwen.js"],
      "run_at": "document_idle"
    }
  ],
  "omnibox": { "keyword": "pp" },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Open Prompt Multiple AIs"
    }
  },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] }
}
